<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Promotor Wizmart</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>wizmart_app</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- Deep link: esquema customizado wizmartapp:// (login automático /
	     magic link e redefinição de senha). Mesmo esquema/host do app
	     FlutterFlow antigo. FlutterDeepLinkingEnabled faz o go_router
	     rotear pelo caminho da URL. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>wizmartapp.com</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>wizmartapp</string>
			</array>
		</dict>
	</array>
	<key>FlutterDeepLinkingEnabled</key>
	<true/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>O app precisa da câmera pra tirar as fotos das visitas em PDV.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>O app precisa do acesso à galeria pra selecionar fotos das visitas.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>O app salva as fotos das visitas no carretel do iPhone.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>O app precisa da localização pra registrar onde a visita aconteceu.</string>
	<!-- Apple exige as duas chaves abaixo mesmo que a gente só use
	     "when in use" — geolocator e outras SDKs referenciam APIs de
	     "always" e a validação ITMS-90683 reclama se faltar. -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>O app precisa da localização pra registrar onde a visita aconteceu, inclusive em background quando estiver sincronizando.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>O app precisa da localização pra registrar onde a visita aconteceu, inclusive em background quando estiver sincronizando.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>wizmart_bg_sync</string>
		<string>be.tramckrijte.workmanager.iOSBackgroundAppRefresh</string>
		<string>be.tramckrijte.workmanager.iOSBackgroundProcessingTask</string>
	</array>
	<!-- App usa apenas criptografia padrão isenta (HTTPS via Supabase
	     e Keychain via flutter_secure_storage). Declarar false aqui
	     evita o popup "Faltam dados de conformidade" em todo build. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
